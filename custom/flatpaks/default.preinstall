# Default Flatpak applications
# These will be installed on first boot
# Format: INI file with [Flatpak Preinstall NAME] groups
# See: https://docs.flatpak.org/en/latest/flatpak-command-reference.html#flatpak-preinstall

# Bootstrap-phase sanity check: proves the flatpak preinstall path works.
# Flatseal (flatpak permission manager) is chosen because the Bluefin base
# does NOT already ship it (unlike Extension Manager, which it does), so its
# presence on a booted system is a real end-to-end test of this pipeline --
# and it's genuinely useful for managing the permissions of the sandboxed
# security GUI apps we'll add later.
[Flatpak Preinstall com.github.tchx84.Flatseal]
Branch=stable

# Wireshark (protocol analyzer). NOTE: the Flathub build is sandboxed and does
# NOT support live capture -- it opens/analyzes existing pcap/pcapng files only.
# Live capture needs host/container-side dumpcap privileges (deferred item).
[Flatpak Preinstall org.wireshark.Wireshark]
Branch=stable

# Burp Suite Community Edition (web proxy / app-security testing). NOTE: this is
# a community-maintained Flathub WRAPPER of the proprietary Burp Community build;
# it is not verified by or affiliated with PortSwigger. ~700 MiB download.
[Flatpak Preinstall net.portswigger.BurpSuite-Community]
Branch=stable

# Uncomment the apps you want installed on first boot:

;[Flatpak Preinstall org.mozilla.firefox]
;Branch=stable

;[Flatpak Preinstall org.mozilla.Thunderbird]
;Branch=stable

;[Flatpak Preinstall org.gnome.Calculator]
;Branch=stable
