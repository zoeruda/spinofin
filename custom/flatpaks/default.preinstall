### --- spinofin additions (not already covered by Bluefin defaults above) ---

# Protocol analyzer. Flathub build opens existing pcaps only -- no live capture
# (that needs privileged dumpcap; run wireshark inside the Kali container).
[Flatpak Preinstall org.wireshark.Wireshark]
Branch=stable

# Burp Suite Community -- community-maintained Flathub wrapper of the
# proprietary Burp build (not affiliated with PortSwigger). ~700 MiB.
[Flatpak Preinstall net.portswigger.BurpSuite-Community]
Branch=stable

# Hierarchical note-taking for structured pentest notes
[Flatpak Preinstall net.giuspen.cherrytree]
Branch=stable

# Markdown knowledge base -- engagement notes / reporting
[Flatpak Preinstall md.obsidian.Obsidian]
Branch=stable

# Local password manager -- organize credentials found during engagements
[Flatpak Preinstall org.keepassxc.KeePassXC]
Branch=stable

# Remote desktop client (RDP / VNC / SSH). Sandbox may block ~/.ssh -- grant via Flatseal if needed.
[Flatpak Preinstall org.remmina.Remmina]
Branch=stable
