# spinofin panel logo. Two extensions can own the panel logo on Bluefin:
#   - custom-command-list (icon NAME -> themed symbolic lookup, recolored)
#   - Logo-menu (custom icon FILE PATH; St still recolors *-symbolic.svg, which
#     is how Bluefin's own ublue-logo-symbolic.svg renders through this path)
# We set both so whichever is active shows the spinofin mark. The companion
# locks/ file forces these over any per-user dconf value left on an existing
# Bluefin install (a plain system default can't win against the user db, which
# bootc switch never touches).
[org/gnome/shell/extensions/custom-command-list]
menuicon-setting='spinofin-logo-symbolic'

[org/gnome/shell/extensions/Logo-menu]
use-custom-icon=true
custom-icon-path='/usr/share/icons/hicolor/scalable/actions/spinofin-logo-symbolic.svg'
symbolic-icon=true
