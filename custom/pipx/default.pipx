# spinofin host-side Python tools -- installed with: ujust install-pipx-tools
# Each app installs into its own pipx venv under ~/.local (not baked into the
# image). One spec per line (PyPI name, name==version, or git+https URL).
# Comments must be on their OWN line -- a git URL may contain a `#egg=` fragment,
# and the installer treats anything after leading whitespace as the full spec.

bloodyAD
soaphound
bloodhound-ce
wafw00f
arjun
certipy-ad
sslyze
ldapdomaindump

# Not host-installable (need system build headers) -> Kali container instead:
#   powerview.py -> ujust setup-powerview   (gssapi needs libkrb5-dev + python3-dev)
#   wfuzz        -> baked into the container (no maintained host install)
